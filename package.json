{
  "name": "webforge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "security:smoke": "node scripts/security-smoke.mjs",
    "source:smoke": "node scripts/source-smoke.mjs",
    "neon:smoke": "node scripts/neon-smoke.mjs",
    "verify": "npm run format:check && npm run security:smoke && npm run source:smoke && npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:csp": "node scripts/csp-check.mjs",
    "test:a11y": "node scripts/a11y-axe.mjs && node scripts/a11y-manual.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:browser:setup": "npm i --no-save playwright @axe-core/playwright && npx playwright install chromium"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.0.0",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "15.5.21",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "vitest": "^4.1.11"
  }
}
