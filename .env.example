# WebForge production secrets — add these in the WebForge Vercel project only.
# Never commit real values; `npm run security:smoke` fails the build if you do.

# Stripe — only the secret key, for creating Checkout sessions.
# The webhook signing secret is NOT here: the webhook is a Supabase Edge
# Function and reads its secret from Supabase Vault.
STRIPE_SECRET_KEY=

# NOTE: SUPABASE_SERVICE_ROLE_KEY is deliberately absent. Since the Stripe
# webhook moved to a Supabase Edge Function, nothing in this app needs full
# database access, so the Vercel deployment no longer holds a key that grants
# it. Do not add it back without a reason.

# Supabase (safe to expose to the browser). Optional: falls back to the
# production project when unset, so a staging deployment only needs these two.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=https://webforge-virid.vercel.app

# Set to "1" once the imprint and privacy policy carry real company data.
# Until then the pricing page hides its Stripe checkout links.
NEXT_PUBLIC_LEGAL_COMPLETE=
