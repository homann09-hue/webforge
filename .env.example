# WebForge production secrets — add these in the WebForge Vercel project only.
# Never commit real values; `npm run security:smoke` fails the build if you do.

# Neon Postgres — provisioned through the Vercel Marketplace.
# Never prefix this with NEXT_PUBLIC_: database credentials are server-only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Migration switch. `neon` currently moves admin login/logout, admin RPCs and
# lead submission to Neon. Portal file storage/download remains on Supabase
# until the Vercel Blob phase. Keep production on `supabase` until preview/E2E
# checks pass.
WEBFORGE_BACKEND=supabase

# Stripe — only the secret key for Checkout at this stage.
# STRIPE_WEBHOOK_SECRET will be added when the webhook moves from Supabase Vault
# to a native Next.js/Vercel route.
STRIPE_SECRET_KEY=

# Temporary Supabase fallback during the migration. Remove after cutover.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=https://webforge-virid.vercel.app

# Set to "1" once the imprint and privacy policy carry real company data.
# Until then the pricing page hides its Stripe checkout links.
NEXT_PUBLIC_LEGAL_COMPLETE=
